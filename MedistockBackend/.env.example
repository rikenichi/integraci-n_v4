# Django
SECRET_KEY=change-me-for-local-development
DEBUG=True

# Database used by current settings.py.
# For local MySQL, keep ENGINE as django.db.backends.mysql and set your local user.
DB_NAME_REMOTE=medistock_db
DB_ENGINE_REMOTE=django.db.backends.mysql
DB_HOST_REMOTE=127.0.0.1
DB_PORT_REMOTE=3306
DB_USER_REMOTE=replace-with-local-mysql-user
DB_PASSWORD_REMOTE=replace-with-local-mysql-password

# Legacy/local names kept for documentation if settings.py is later switched back.
DB_NAME=medistock_db
DB_ENGINE=django.db.backends.mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=replace-with-local-mysql-user
DB_PASSWORD=replace-with-local-mysql-password

# Chilexpress: document the required names without storing private keys.
CHILEXPRESS_BASE_URL=https://example.invalid/chilexpress
CHILEXPRESS_API_VERSION=v1
CHILEXPRESS_API_KEY_OT=replace-with-local-key
CHILEXPRESS_API_KEY_COBERTURA=replace-with-local-key
CHILEXPRESS_API_KEY_COTIZADOR=replace-with-local-key
CHILEXPRESS_TCC=replace-with-local-code

# MEDISTOCK sender data used by integrations.
MEDISTOCK_RUT=00000000-0
MEDISTOCK_TELEFONO=+56000000000
MEDISTOCK_EMAIL=contacto@example.invalid

# Transbank Webpay test/local configuration.
TRANSBANK_ENVIRONMENT=TEST
TRANSBANK_WEBPAY_COMMERCE_CODE=replace-with-test-commerce-code
TRANSBANK_WEBPAY_API_KEY=replace-with-test-api-key
