# Local development: use /api so requests go through vite.config.js proxy.
VITE_API_URL=/api

# Local direct backend access also remains supported when needed:
# VITE_API_URL=http://localhost:8000/api

# Production option A: frontend and backend behind the same domain/reverse proxy.
# VITE_API_URL=/api

# Production option B: separate frontend/backend domains.
# VITE_API_URL=https://api.example.com/api
